# Required — from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Optional — pre-register the alert chat (otherwise just /start the bot)
TELEGRAM_CHAT_ID=

# Public mode (default true): anyone can /start and use the bot.
# Set to false to restrict access to the allowlist below.
TELEGRAM_PUBLIC=true

# Admin chat ids, comma-separated (put YOUR id here). Admins can use the
# global-control commands (/mute /watch /check /digest). In private mode
# this list also acts as the access allowlist.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional — enables the Ethereum/NUVA contracts monitor (free key: etherscan.io)
ETHERSCAN_API_KEY=

# Optional — higher CoinGecko rate limits (demo key works)
COINGECKO_API_KEY=

# Optional — higher GitHub API rate limits
GITHUB_TOKEN=

# Optional — Discord announcement-channel monitor
DISCORD_BOT_TOKEN=

# Optional — enables the Claude-powered AI analyst (console.anthropic.com);
# without it the platform uses deterministic rule-based analysis briefs
ANTHROPIC_API_KEY=
